      properties:
        meta:
          "$ref": "#/components/schemas/NotificationReadMeta"
      required:
      - meta
    PaginationMeta:
      type: object
      description: Pagination metadata
      properties:
        current_page:
          type: integer
          description: Current page number
          example: 1
        next_page:
          type:
          - integer
          - 'null'
          description: Next page number (null if last page)
          example: 2
        prev_page:
          type:
          - integer
          - 'null'
          description: Previous page number (null if first page)
        per_page:
          type: integer
          description: Number of items per page
          example: 25
        total_pages:
          type: integer
          description: Total number of pages available
          example: 5
        total_count:
          type: integer
          description: Total number of items available
          example: 120
        has_more_pages:
          type: boolean
          description: Whether there are more pages available
          example: true
      required:
      - current_page
      - per_page
      - total_pages
      - total_count
      - has_more_pages
    PaginatedResponse:
