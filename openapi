  "/v3/uploads/presign":
    post:
      summary: Get a presigned upload URL
      description: |
        Returns presigned S3 PUT URLs for direct file upload. Use this to upload
        files (images, attachments) without sending them through the API server.
        Supports up to 50 files per request.

        **Upload flow:**
        1. Call this endpoint with an array of files (filename + content type)
        2. PUT each file's bytes to its returned `upload_url` with the matching `Content-Type` header
        3. Create blocks via `POST /v3/blocks` with `value` set to the S3 URL:
           `https://s3.amazonaws.com/arena_images-temp/<key>`

        Presigned URLs expire after 1 hour.

        **Authentication required.**
      operationId: presignUpload
      tags:
      - Uploads
      security:
      - BearerAuth: []
      - OAuth2:
        - write
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                files:
                  type: array
                  description: Array of files to generate presigned URLs for
                  minItems: 1
                  maxItems: 50
                  items:
                    type: object
                    properties:
                      filename:
                        type: string
                        description: Name of the file to upload
                        example: photo.jpg
                      content_type:
                        type: string
                        description: MIME type of the file
                        example: image/jpeg
                    required:
                    - filename
                    - content_type
              required:
              - files
            examples:
              single_file:
                summary: Presign a single image upload
                value:
                  files:
                  - filename: photo.jpg
                    content_type: image/jpeg
              multiple_files:
                summary: Presign multiple uploads
                value:
                  files:
                  - filename: photo1.jpg
                    content_type: image/jpeg
                  - filename: photo2.png
                    content_type: image/png
                  - filename: document.pdf
                    content_type: application/pdf
      responses:
        '201':
          description: Presigned URLs generated
          content:
            application/json:
              schema:
                "$ref": "#/components/schemas/PresignResponse"
        '400':
          "$ref": "#/components/responses/BadRequestResponse"
        '401':
          "$ref": "#/components/responses/UnauthorizedResponse"
        '408':
          "$ref": "#/components/responses/RequestTimeoutResponse"
        '429':
          "$ref": "#/components/responses/RateLimitResponse"
  "/v3/blocks":
    post:
      summary: Create a block
      description: |
        Creates a new block and connects it to one or more channels.

        The `value` field accepts either a URL or text content:
        - If `value` is a valid URL, the block type is inferred (Image, Link, Embed, etc.)
        - If `value` is plain text, a Text block is created

        You can connect the block to multiple channels at once (up to 20).

        Specify target channels using either `channels` (preferred) or `channel_ids` (legacy), but not both.
        The `channels` form allows per-channel position and connection metadata.

        **Authentication required.**
      operationId: createBlock
      tags:
      - Blocks
      security:
      - BearerAuth: []
      - OAuth2:
        - write
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
              - "$ref": "#/components/schemas/BlockInput"
              - oneOf:
                - type: object
                  description: 'Legacy form: flat channel_ids array'
                  properties:
                    channel_ids:
                      "$ref": "#/components/schemas/ChannelIds"
                    insert_at:
                      type: integer
                      description: |
                        Position to insert the block in the channel (1-indexed).
                        Only valid when connecting to a single channel.
                      example: 1
                  required:
                  - channel_ids
                  not:
                    required:
                    - channels
                - type: object
                  description: 'Structured form: per-channel position and connection
                    metadata'
                  properties:
                    channels:
                      type: array
                      description: Target channels with optional per-channel position
                        and connection metadata.
                      items:
                        "$ref": "#/components/schemas/ConnectTo"
                      minItems: 1
                      maxItems: 20
                  required:
                  - channels
                  not:
                    anyOf:
                    - required:
                      - channel_ids
                    - required:
                      - insert_at
            examples:
              text_block:
                summary: Create a text block (legacy)
                value:
                  value: This is a **text** block with markdown
                  channel_ids:
                  - 123
                  title: My Text Block
              with_channels:
                summary: Create with per-channel metadata
                value:
                  value: https://example.com/image.jpg
                  channels:
                  - id: 123
                    position: 1
                    metadata:
                      source: import
                  - id: 456
              link_block:
                summary: Create a link block (legacy)
                value:
                  value: https://example.com/article
                  channel_ids:
                  - 123
                  title: Interesting Article
                  description: Found this interesting article
                  original_source_url: https://example.com/article
                  original_source_title: Example Article
      responses:
        '201':
          description: Block created successfully
          content:
            application/json:
              schema:
                "$ref": "#/components/schemas/Block"
        '400':
          "$ref": "#/components/responses/ValidationErrorResponse"
        '401':
          "$ref": "#/components/responses/UnauthorizedResponse"
        '403':
          description: Cannot add to one or more channels
          content:
            application/json:
              schema:
                "$ref": "#/components/schemas/Error"
        '404':
          "$ref": "#/components/responses/NotFoundResponse"
        '408':
          "$ref": "#/components/responses/RequestTimeoutResponse"
        '429':
          "$ref": "#/components/responses/RateLimitResponse"
  "/v3/blocks/batch":
    post:
      summary: Batch create blocks
      description: |
        Queues multiple blocks for asynchronous creation and connects them to one
        or more channels. Returns immediately with a `batch_id` that can be used
        to poll for status via `GET /v3/blocks/batch/{batch_id}`.

        Designed for import use cases such as migrating from other services
        or re-importing Are.na exports.

        Each block in the `blocks` array follows the same format as single block
        creation. Blocks are processed sequentially in the background and partial
        success is supported — if some blocks fail, the successful ones are still
        created.

        **Limits:**
        - Maximum 50 blocks per request
        - Maximum 20 channels per request
        - All channels must be **private**

        **Batch results are available for 24 hours after submission.**

        **⚠️ Premium Only**: This endpoint requires a Premium subscription.
      operationId: batchCreateBlocks
      tags:
      - Blocks
      security:
      - BearerAuth: []
      - OAuth2:
        - write
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                channel_ids:
                  "$ref": "#/components/schemas/ChannelIds"
                blocks:
                  type: array
                  description: Array of blocks to create
                  minItems: 1
                  maxItems: 50
                  items:
                    "$ref": "#/components/schemas/BlockInput"
              required:
              - channel_ids
              - blocks
            examples:
              mixed_blocks:
                summary: Import mixed content types
                value:
                  channel_ids:
                  - 123
                  blocks:
                  - value: https://example.com/image1.jpg
                    title: First image
                    alt_text: A landscape photo
                  - value: https://example.com/image2.jpg
                    original_source_url: https://example.com/123
                    original_source_title: Example
                  - value: Some text content to import
                    title: Text note
      responses:
        '202':
          description: Batch accepted for processing
          content:
            application/json:
              schema:
                "$ref": "#/components/schemas/BatchResponse"
        '400':
          "$ref": "#/components/responses/BadRequestResponse"
        '401':
          "$ref": "#/components/responses/UnauthorizedResponse"
        '403':
          description: Forbidden — requires Premium subscription, or cannot add to
            one or more channels
          content:
            application/json:
              schema:
                "$ref": "#/components/schemas/Error"
        '404':
          "$ref": "#/components/responses/NotFoundResponse"
        '422':
          "$ref": "#/components/responses/UnprocessableEntityResponse"
        '408':
          "$ref": "#/components/responses/RequestTimeoutResponse"
        '429':
          "$ref": "#/components/responses/RateLimitResponse"
