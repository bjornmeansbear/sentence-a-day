  "/v3/connections":
    post:
      summary: Create a connection
      operationId: createConnection
      description: |
        Connects a block or channel to one or more channels.
        Returns the created connection(s).

        Specify target channels using either `channels` (preferred) or `channel_ids` (legacy), but not both.
        The `channels` form allows per-channel position and connection metadata.

        **Authentication required.**
      tags:
      - Connections
      security:
      - BearerAuth: []
      - OAuth2:
        - write
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
              - type: object
                required:
                - connectable_id
                - connectable_type
                properties:
                  connectable_id:
                    type: integer
                    description: ID of the block or channel to connect.
                  connectable_type:
                    "$ref": "#/components/schemas/ConnectableType"
                    description: Type of the connectable.
              - oneOf:
                - type: object
                  description: 'Legacy form: flat channel_ids array'
                  properties:
                    channel_ids:
                      "$ref": "#/components/schemas/ChannelIds"
                    position:
                      type: integer
                      description: |
                        Position to insert at within the channel (1-indexed).
                        Only valid when connecting to a single channel.
                  required:
                  - channel_ids
                  not:
                    required:
                    - channels
                - type: object
                  description: 'Structured form: per-channel position and connection
                    metadata'
                  properties:
                    channels:
                      type: array
                      description: Target channels with optional per-channel position
                        and connection metadata.
                      items:
                        "$ref": "#/components/schemas/ConnectTo"
                      minItems: 1
                      maxItems: 20
                  required:
                  - channels
                  not:
                    anyOf:
                    - required:
                      - channel_ids
                    - required:
                      - position
      responses:
        '201':
          description: Connection(s) created successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    type: array
                    items:
                      "$ref": "#/components/schemas/Connection"
        '400':
          "$ref": "#/components/responses/BadRequestResponse"
        '401':
          "$ref": "#/components/responses/UnauthorizedResponse"
        '403':
          "$ref": "#/components/responses/ForbiddenResponse"
        '404':
