        - `investor`: Investor
        - `supporter`: Supporter subscriber
        - `premium`: Premium subscriber
      enum:
      - staff
      - investor
      - supporter
      - premium
    UserTier:
      type: string
      description: |
        User subscription tier:
        - `guest`: Unauthenticated user
        - `free`: Free account
        - `premium`: Premium subscriber
        - `supporter`: Supporter tier
      enum:
      - guest
      - free
      - premium
      - supporter
    BlockState:
      type: string
      description: |
