\define published() [!is[system]] +[!tag[private]] +[!tag[hide]] +[!prefix[.]]
<div class="home">
    {{WjerkNav}}
    {{SiteIntro}}
    <section class="startHere" aria-labelledby="startHeading">
        <h2 id="startHeading">Start here</h2>
        <ul>
            <$list filter="[enlist{HomeDoors!!start}]" variable="page">
                <li>
                    <$link to=<<page>>>
                        <span class="startTitle"><$text text={{{ [<page>get[caption]else<page>] }}}/></span>
                        <span class="startNote"><$transclude tiddler=<<page>> field="description" mode="inline"/></span>
                    </$link>
                    <$list filter="[<page>has[themes]]" variable="ignore">
                        <p class="startThemes">More on <$list filter="[<page>get[themes]enlist-input[]]" variable="theme" join=", "><$link to=<<theme>>><$text text={{{ [[HomeDoors]getindex<theme>else<theme>] }}}/></$link></$list></p>
                    </$list>
                </li>
            </$list>
        </ul>
    </section>
    <nav class="doors" aria-labelledby="doorsHeading">
        <h2 id="doorsHeading">Browse by kind</h2>
        <ul>
            <$list filter="[list[HomeDoors]]" variable="door">
                <li data-door=<<door>>>
                    <$link to=<<door>>>
                        <span class="doorName"><$text text={{{ [[HomeDoors]getindex<door>else<door>] }}}/></span>
                        <span class="doorCount"><$text text={{{ [tag<door>!tag[private]!tag[hide]!prefix[.]count[]] }}}/></span>
                        <span class="doorNote"><$transclude tiddler=<<door>> field="description" mode="inline"/></span>
                    </$link>
                </li>
            </$list>
        </ul>
        <h3 id="collectedHeading">Collected</h3>
        <ul class="collected" aria-labelledby="collectedHeading">
            <$list filter="[list[HomeDoors!!collection]]" variable="door">
                <li data-door=<<door>>>
                    <$link to=<<door>>>
                        <span class="doorName"><$text text={{{ [[HomeDoors]getindex<door>else<door>] }}}/></span>
                        <span class="doorCount"><$text text={{{ [tag<door>!tag[private]!tag[hide]!prefix[.]count[]] }}}/></span>
                        <span class="doorNote"><$transclude tiddler=<<door>> field="description" mode="inline"/></span>
                    </$link>
                </li>
            </$list>
        </ul>
    </nav>
    {{EntryList}}
    {{WjerkFooter}}
</div>