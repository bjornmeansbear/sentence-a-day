title: MetaInfoTemplate
type: text/vnd.tiddlywiki

\define metaLabel() <$text text={{{ [[MetaInfoFields]getindex<field>else<field>] }}}/>
<div class="infoTable fieldDisplay">
<$list filter="[list[MetaInfoFields]]" variable="field">
<$list filter="[all[current]has<field>]" variable="_">
<$list filter="[<field>!match[city]!match[coverurl]]" variable="_">
<section class="row flex">
<div class="key"><<metaLabel>></div>
<div class="value"><$transclude field=<<field>> mode="inline"/></div>
</section>
</$list>
<$list filter="[<field>match[city]]" variable="_">
<section class="row flex">
<div class="key"><<metaLabel>></div>
<div class="value">{{!!city}}, {{!!state}}, {{!!location}}</div>
</section>
</$list>
<$list filter="[<field>match[coverurl]]" variable="_">
<section class="row flex">
<div class="imgWrapper bookCover"><img src={{!!coverurl}} /></div>
</section>
</$list>
</$list>
</$list>
</div>