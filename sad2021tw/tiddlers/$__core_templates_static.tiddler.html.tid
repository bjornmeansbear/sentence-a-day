title: $:/core/templates/static.tiddler.html
type: text/vnd.tiddlywiki

\define tv-wikilink-template() $uri_doubleencoded$.html
\define tv-config-toolbar-icons() no
\define tv-config-toolbar-text() no
\define tv-config-toolbar-class() tc-btn-invisible
\define wjerk-static() yes
\import [[$:/core/ui/PageMacros]] [all[shadows+tiddlers]tag[$:/tags/Macro]!has[draft.of]]
`<!doctype html>
<html lang="en">
<head>
<meta http-equiv="Content-Type" content="text/html;charset=utf-8" />
<meta name="generator" content="TiddlyWiki" />
<meta name="tiddlywiki-version" content="`{{$:/core/templates/version}}`" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="mobile-web-app-capable" content="yes"/>
<meta name="format-detection" content="telephone=no">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="static.css">
<title>`<$view field="caption"><$view field="title"/></$view>: {{$:/core/wiki/title}}`</title>
</head>
<body class="tc-body">

`<$view tiddler="WjerkNav" field="text" format="text"/>`

`{{$:/StaticBanner||$:/core/templates/html-tiddler}}`
<div class="wjerk-tiddler-columns">
<section class="tc-story-river tc-static-story-river">
`<$view tiddler="$:/core/ui/ViewTemplate" format="htmlwikified"/>`
</section>

<!-- KB Additions -->
<div class="tc-sidebar-scrollable" style="overflow: auto;">
`<$view tiddler="SiteIntro" field="text" format="text"/>`
<!-- Search: sends the word to search.html, which holds the list of every page and filters it (?q=). The button is there so the search doesn't depend on knowing to press Enter. -->
<form class="sidebarSearch" action="../search.html" method="get" role="search">
<label class="searchLabel" for="sidebarSearchInput">Search all pages</label>
<div class="searchRow">
<input class="search" id="sidebarSearchInput" type="search" name="q" placeholder="Type a word or a name…">
<button class="searchButton" type="submit">Search</button>
</div>
</form>
</div>
</div>

<!-- The same footer as the homepage and search.html, written once in WjerkFooter. -->
`<$view tiddler="WjerkFooter" format="htmlwikified"/>`

</body>
</html>
`
