{
    "description": "Basic client-server edition",
    "plugins": [
        "tiddlywiki/tiddlyweb",
        "tiddlywiki/filesystem",
        "tiddlywiki/highlight"
    ],
    "themes": [
        "tiddlywiki/vanilla"
    ],
    "build": {
        "static": [
            "--rendertiddler",
            "$:/core/templates/static.template.html",
            "index.html",
            "text/plain",
            "--rendertiddlers",
            "[!is[system]] +[!tag[private]] +[!tag[hide]] +[!prefix[.]]",
            "$:/core/templates/static.tiddler.html",
            "static",
            "text/plain",
            "--rendertiddlers",
            "[all[tiddlers]tags[]is[missing]!prefix[$:/]!prefix[.]!match[hide]!match[private]]",
            "$:/core/templates/static.tagpage.html",
            "static-tags",
            "text/plain",
            "--rendertiddler",
            "$:/core/templates/static.template.css",
            "static/static.css",
            "text/plain",
            "--rendertiddler",
            "$:/core/templates/404.html",
            "404.html",
            "text/plain"
        ]
    }
}